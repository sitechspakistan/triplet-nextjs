{
    "welcome": {
        "message": "Hi there 👋 I'm Webefy's AI Assistant. I'll help match you with the right solution in just a few quick questions. What are you looking for?",
        "step": "service_selection"
    },
    "services": [
        {
            "id": "web",
            "label": "🌐 Website Development",
            "description": " - Landing pages, business sites, e-commerce"
        },
        {
            "id": "ai",
            "label": "⚡ AI Automation",
            "description": " - Workflows, chatbots, integrations"
        },
        {
            "id": "branding",
            "label": "🎨 Branding & Identity",
            "description": " - Logo, style guide, visual identity"
        },
        {
            "id": "other",
            "label": "💬 Other Inquiry",
            "description": " - Tell us what's on your mind"
        }
    ],
    "flows": {
        "web": [
            {
                "id": "web_type",
                "question": "What type of website do you need?",
                "type": "quick_reply",
                "options": [
                    "Business / Portfolio",
                    "E-Commerce Store",
                    "Restaurant / Food",
                    "Clinic / Medical",
                    "Real Estate",
                    "Other"
                ]
            },
            {
                "id": "web_features",
                "question": "Which features are important to you?",
                "type": "quick_reply",
                "options": [
                    "Online Payments",
                    "Booking System",
                    "Blog / CMS",
                    "WhatsApp Integration",
                    "Custom Dashboard",
                    "Just a Simple Site"
                ]
            },
            {
                "id": "web_existing",
                "question": "Do you have an existing website?",
                "type": "quick_reply",
                "options": [
                    "Yes, needs a redesign",
                    "No, starting fresh",
                    "I have a design ready"
                ]
            }
        ],
        "ai": [
            {
                "id": "ai_goal",
                "question": "What's the main goal for automation?",
                "type": "quick_reply",
                "options": [
                    "Save time on repetitive tasks",
                    "Build a customer chatbot",
                    "Connect my apps (CRM, Sheets, etc.)",
                    "Generate AI content",
                    "Something else"
                ]
            },
            {
                "id": "ai_tools",
                "question": "Which tools are you currently using?",
                "type": "quick_reply",
                "options": [
                    "Google Workspace",
                    "HubSpot / Salesforce",
                    "Shopify",
                    "Custom software",
                    "None yet"
                ]
            }
        ],
        "branding": [
            {
                "id": "brand_need",
                "question": "What do you need help with?",
                "type": "quick_reply",
                "options": [
                    "New logo only",
                    "Full brand identity",
                    "Brand refresh / redesign",
                    "Social media kit",
                    "All of the above"
                ]
            },
            {
                "id": "brand_stage",
                "question": "Where is your business right now?",
                "type": "quick_reply",
                "options": [
                    "Just starting out",
                    "Established but rebranding",
                    "Launching a new product",
                    "Scaling up"
                ]
            }
        ],
        "other": [
            {
                "id": "other_topic",
                "question": "What would you like to discuss?",
                "type": "quick_reply",
                "options": [
                    "Digital Marketing",
                    "SEO",
                    "Content Writing",
                    "Consulting",
                    "Partnership / Collab",
                    "Something else"
                ]
            }
        ]
    },
    "common": [
        {
            "id": "name",
            "question": "What's your name?",
            "type": "text",
            "placeholder": "Your full name"
        },
        {
            "id": "email",
            "question": "What's the best email to reach you at?",
            "type": "text",
            "placeholder": "you@example.com"
        },
        {
            "id": "phone",
            "question": "Your phone or WhatsApp number?",
            "type": "text",
            "placeholder": "+1 234 567 8900"
        },
        {
            "id": "budget",
            "question": "What's your approximate budget?",
            "type": "quick_reply",
            "options": [
                "Under $500",
                "$500 – $1,500",
                "$1,500 – $5,000",
                "$5,000 – $15,000",
                "$15,000+",
                "Not sure yet"
            ]
        },
        {
            "id": "timeline",
            "question": "When do you need this completed?",
            "type": "quick_reply",
            "options": [
                "ASAP (within 2 weeks)",
                "1 Month",
                "2–3 Months",
                "Flexible / No rush"
            ]
        },
        {
            "id": "requirements",
            "question": "Any extra details or specific requirements? (optional — press Send or skip)",
            "type": "text",
            "placeholder": "Tell us anything else...",
            "optional": true
        }
    ]
}